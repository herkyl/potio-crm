{
	"name": "potio-crm",
	"description": "Lead CRM. Triages candidates from the Skool scanner and works them on a board.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"migrate": "node --env-file=.env scripts/migrate.js",
		"ingest": "node --env-file=.env scripts/ingest.js",
		"preflight": "node --env-file=.env scripts/preflight.js",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.10.2",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"less": "^4.3.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-preprocess": "^6.0.3",
		"vite": "^6.2.6"
	},
	"dependencies": {
		"@libsql/client": "^0.14.0",
		"svelte-dnd-action": "^0.9.61"
	}
