# Copy to .env and fill in. Never commit .env.

# --- Required ---

# Turso / libSQL. The same database the Skool scanner writes to.
# This app reads members/member_classification/posts and writes only to its own
# five tables (sources, source_leads, people, prospects, activities).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# HTTP Basic Auth for the CRM UI (SPEC §5.2). If either is unset the app allows
# access in dev and refuses every request in production.
AUTH_USER=
AUTH_PASSWORD=

# --- Optional ---

# Google Gemini, for first-message drafts. Server-side only.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rolling 7-day soft cap on LinkedIn invites, for the worklist counter (SPEC §3.6).
# Advisory only — derived from this app's own invite_sent_at timestamps.
INVITE_WEEKLY_CAP=100
